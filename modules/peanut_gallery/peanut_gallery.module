<?php

/**
 * @file
 * Hook implementations for the Peanut Gallery module.
 *
 * Every access decision in this file is a thin wrapper around a single
 * shared computation (see Drupal\peanut_gallery\Access\RecordingGrantsBuilder
 * and Drupal\peanut_gallery\Access\RecordingFileLocator) so that the node
 * page, the private audio download, and comment visibility can never drift
 * out of sync with each other.
 */

declare(strict_types=1);

use Drupal\comment\CommentInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\StringTranslation\ByteSizeMarkup;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;
use Drupal\user\Entity\User;

/**
 * Implements hook_help().
 */
function peanut_gallery_help(string $route_name, RouteMatchInterface $route_match): ?string {
  if ($route_name === 'help.page.peanut_gallery') {
    return '<p>' . t('Upload long audio recordings and let visitors comment on an exact moment in the recording by clicking a waveform player.') . '</p>';
  }
  return NULL;
}

/**
 * Implements hook_node_access_records().
 */
function peanut_gallery_node_access_records(NodeInterface $node): array {
  return \Drupal::service('peanut_gallery.grants_builder')->buildAccessRecords($node);
}

/**
 * Implements hook_node_grants().
 */
function peanut_gallery_node_grants(AccountInterface $account, string $op): array {
  return \Drupal::service('peanut_gallery.grants_builder')->buildGrants($account, $op);
}

/**
 * Implements hook_file_download().
 */
function peanut_gallery_file_download(string $uri): array|int|null {
  $match = \Drupal::service('peanut_gallery.file_locator')->getRecordingForUri($uri);
  if ($match === NULL) {
    // Not a Peanut Gallery file — abstain, don't interfere with other
    // modules' private files.
    return NULL;
  }
  [$node, $file] = $match;
  if (!$node->access('view', \Drupal::currentUser())) {
    return -1;
  }
  return [
    'Content-Type' => $file->getMimeType(),
    'Content-Length' => $file->getSize(),
    // Inline (not attachment) so <audio> can stream and seek it.
    'Content-Disposition' => 'inline; filename="' . $file->getFilename() . '"',
    // Access varies per user — must never be cached by a shared/proxy cache.
    'Cache-Control' => 'private',
  ];
}

/**
 * Implements hook_comment_create_access().
 *
 * This covers the generic entity API (e.g. code calling
 * Comment::create(...)->access('create')), but NOT the actual
 * comment.reply route real visitors submit comments through — see
 * hook_route_alter() and RecordingCommentReplyAccessCheck for why that
 * needs its own, separate enforcement.
 *
 * Two independent checks here:
 * - View-gates comment creation on the host recording. This is required,
 *   not optional: CommentAccessControlHandler::checkCreateAccess() is
 *   nothing more than a flat 'post comments' permission check — it never
 *   verifies the account can view the commented entity at all. Without
 *   this, any authenticated user holding the generic 'post comments'
 *   permission could comment on any private recording, sharing/visibility
 *   entirely bypassed.
 * - Enforces the per-recording "allow anonymous comments" override on top
 *   of that. Returns AccessResult::forbidden(), never neutral(), when the
 *   override is off — forbidden() is sticky in Drupal's access-result
 *   combination, so this cannot be overridden by an allowed() elsewhere
 *   even if the anonymous role has been granted 'post comments' too.
 */
function peanut_gallery_comment_create_access(AccountInterface $account, array $context, string $entity_bundle): AccessResultInterface {
  if ($entity_bundle !== 'recording_comment') {
    return AccessResult::neutral();
  }

  $commented_entity = $context['commented_entity'] ?? NULL;
  if (!$commented_entity instanceof NodeInterface) {
    return AccessResult::neutral();
  }

  $view_access = $commented_entity->access('view', $account, TRUE);
  if (!$view_access->isAllowed()) {
    return AccessResult::forbidden()->addCacheableDependency($view_access);
  }

  if ($account->isAuthenticated()) {
    return AccessResult::neutral()->addCacheableDependency($view_access);
  }

  if ($commented_entity->hasField('field_allow_anonymous_comments') && (bool) $commented_entity->get('field_allow_anonymous_comments')->value) {
    return AccessResult::neutral()->addCacheableDependency($commented_entity)->addCacheableDependency($view_access);
  }
  return AccessResult::forbidden('Anonymous comments are not allowed on this recording.')
    ->addCacheableDependency($commented_entity)
    ->addCacheableDependency($view_access);
}

/**
 * Implements hook_ENTITY_TYPE_access() for the comment entity type.
 *
 * Two independent checks, both restriction-only:
 * - Closes a gap core leaves open: viewing an *existing* comment does not,
 *   by itself, re-check the host entity's view access. Without this, a
 *   private recording's comments could leak via /comment/{id}, a Views
 *   block, or JSON:API even though the recording node itself is protected.
 * - Enforces the recording's "comments visible to shared listeners"
 *   toggle: when off, a non-owner, non-bypass viewer only sees comments
 *   they authored themselves or that the owner authored.
 */
function peanut_gallery_comment_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  if ($operation !== 'view' || !$entity instanceof CommentInterface || $entity->bundle() !== 'recording_comment') {
    return AccessResult::neutral();
  }

  $host = $entity->getCommentedEntity();
  if (!$host instanceof NodeInterface) {
    return AccessResult::neutral();
  }

  $host_access = $host->access('view', $account, TRUE);
  if (!$host_access->isAllowed()) {
    return AccessResult::forbidden()->addCacheableDependency($host_access);
  }

  if (!$account->hasPermission('bypass peanut gallery private recording access')) {
    $can_view = \Drupal::service('peanut_gallery.access_checker')
      ->canViewCommentUnderIsolation($host, $account, (int) $entity->getOwnerId());
    if (!$can_view) {
      return AccessResult::forbidden()
        ->cachePerUser()
        ->addCacheableDependency($host)
        ->addCacheableDependency($entity);
    }
  }

  return AccessResult::neutral()->addCacheableDependency($host_access);
}

/**
 * Implements hook_page_attachments().
 *
 * Links the web app manifest and the iOS-specific meta tags on every page.
 * Safari decides whether "Add to Home Screen" produces a real standalone
 * app — the precondition for Web Push on iOS — from these, and it reads
 * them on whatever page the visitor happens to be on.
 */
function peanut_gallery_page_attachments(array &$attachments): void {
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'manifest',
      'href' => Url::fromRoute('peanut_gallery.manifest')->toString(),
    ],
  ];

  // iOS ignores the manifest's icons for the Home Screen and uses this.
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'apple-touch-icon',
      'href' => base_path() . \Drupal::service('extension.list.module')->getPath('peanut_gallery') . '/images/icon-192.png',
    ],
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => ['name' => 'apple-mobile-web-app-capable', 'content' => 'yes'],
    ],
    'peanut_gallery_ios_capable',
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'apple-mobile-web-app-status-bar-style',
        'content' => 'default',
      ],
    ],
    'peanut_gallery_ios_status_bar',
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => ['name' => 'theme-color', 'content' => '#c2410c'],
    ],
    'peanut_gallery_theme_color',
  ];
}

/**
 * Implements hook_ENTITY_TYPE_insert() for comment entities.
 */
function peanut_gallery_comment_insert(CommentInterface $comment): void {
  _peanut_gallery_announce_comment($comment, 'posted');
}

/**
 * Implements hook_ENTITY_TYPE_update() for comment entities.
 */
function peanut_gallery_comment_update(CommentInterface $comment): void {
  _peanut_gallery_announce_comment($comment, 'edited');
}

/**
 * Runs both notification channels without ever endangering the save.
 *
 * Telling people about a comment is a side effect; storing the comment is
 * the job. A bounced SMTP connection, a push service outage, or a database
 * table missing because the code was deployed a moment before update.php
 * ran must not surface to the person who just pressed Save, and must not
 * roll their comment back. So each channel is isolated and its failure is
 * logged rather than thrown.
 *
 * @param \Drupal\comment\CommentInterface $comment
 *   The comment that was saved.
 * @param string $event
 *   Either 'posted' or 'edited'.
 */
function _peanut_gallery_announce_comment(CommentInterface $comment, string $event): void {
  foreach (['_peanut_gallery_notify_about_comment', '_peanut_gallery_queue_push_about_comment'] as $channel) {
    try {
      $channel($comment, $event);
    }
    catch (\Throwable $e) {
      \Drupal::logger('peanut_gallery')->error('Could not announce comment @id via @channel: @message', [
        '@id' => $comment->id(),
        '@channel' => $channel,
        '@message' => $e->getMessage(),
      ]);
    }
  }
}

/**
 * Queues a push notification per subscribed browser.
 *
 * Queued rather than sent inline: delivery is an HTTPS round-trip to
 * Apple's, Google's or Mozilla's push service, and posting a comment should
 * not wait on — or fail because of — any of them. Cron drains the queue.
 *
 * @param \Drupal\comment\CommentInterface $comment
 *   The comment that was saved.
 * @param string $event
 *   Either 'posted' or 'edited'.
 */
function _peanut_gallery_queue_push_about_comment(CommentInterface $comment, string $event): void {
  if ($comment->bundle() !== 'recording_comment') {
    return;
  }

  /** @var \Drupal\peanut_gallery\Push\PushSubscriptionStore $store */
  $store = \Drupal::service('peanut_gallery.push_subscription_store');
  $subscriptions = $store->loadAll();
  if (!$subscriptions) {
    return;
  }

  $host = $comment->getCommentedEntity();
  $recording = $host instanceof NodeInterface ? $host->label() : t('a recording');
  $body = trim(strip_tags((string) ($comment->get('comment_body')->value ?? '')));

  $payload = [
    'title' => (string) t('Comment @event on "@recording"', [
      '@event' => $event,
      '@recording' => $recording,
    ]),
    'body' => mb_strimwidth($body, 0, 120, '…'),
    'url' => $comment->permalink()->setAbsolute()->toString(),
    // One notification slot per recording, so a burst of comments on the
    // same mix replaces itself instead of stacking.
    'tag' => 'peanut-gallery-' . ($host instanceof NodeInterface ? $host->id() : 'unknown'),
  ];

  $queue = \Drupal::queue('peanut_gallery_push');
  foreach ($subscriptions as $subscription) {
    // A subscriber must still be allowed to see the recording — a device
    // subscribed while its owner had access should not keep receiving
    // quotes from a mix they were later removed from.
    $subscriber = User::load($subscription['uid']);
    if (!$subscriber || !$host instanceof NodeInterface || !$host->access('view', $subscriber)) {
      continue;
    }
    $queue->createItem(['subscription' => $subscription, 'payload' => $payload]);
  }
}

/**
 * Emails the configured addresses about a recording comment.
 *
 * Recipients are a plain site-owner setting, not per-user subscriptions:
 * this exists so whoever runs the gallery hears about activity on their own
 * recordings. Nothing is sent when the list is empty, which is the default.
 *
 * Deliberately fires for unpublished comments too — a comment held for
 * approval is precisely the one worth being told about.
 *
 * @param \Drupal\comment\CommentInterface $comment
 *   The comment that was just saved.
 * @param string $event
 *   Either 'posted' or 'edited'.
 */
function _peanut_gallery_notify_about_comment(CommentInterface $comment, string $event): void {
  if ($comment->bundle() !== 'recording_comment') {
    return;
  }

  $recipients = \Drupal::config('peanut_gallery.settings')->get('notification_emails') ?: [];
  if (!$recipients) {
    return;
  }

  $mail_manager = \Drupal::service('plugin.manager.mail');
  $langcode = \Drupal::config('system.site')->get('langcode') ?: 'en';

  foreach ($recipients as $recipient) {
    $mail_manager->mail(
      'peanut_gallery',
      'comment_notification',
      $recipient,
      $langcode,
      ['comment' => $comment, 'event' => $event],
    );
  }
}

/**
 * Implements hook_mail().
 */
function peanut_gallery_mail(string $key, array &$message, array $params): void {
  if ($key !== 'comment_notification') {
    return;
  }

  /** @var \Drupal\comment\CommentInterface $comment */
  $comment = $params['comment'];
  $host = $comment->getCommentedEntity();
  $recording = $host instanceof NodeInterface ? $host->label() : t('a recording');

  $message['subject'] = t('Comment @event on "@recording"', [
    '@event' => $params['event'],
    '@recording' => $recording,
  ]);

  $lines = [
    t('@author @event a comment on "@recording".', [
      '@author' => $comment->getAuthorName() ?: t('Someone'),
      '@event' => $params['event'],
      '@recording' => $recording,
    ]),
    '',
  ];

  if ($comment->hasField('field_timestamp') && !$comment->get('field_timestamp')->isEmpty()) {
    $lines[] = t('At @time into the recording.', [
      '@time' => _peanut_gallery_format_timestamp((float) $comment->get('field_timestamp')->value),
    ]);
    $lines[] = '';
  }

  if ($comment->hasField('comment_body') && !$comment->get('comment_body')->isEmpty()) {
    $lines[] = trim(strip_tags((string) $comment->get('comment_body')->value));
    $lines[] = '';
  }

  if (!$comment->isPublished()) {
    $lines[] = t('This comment is unpublished and awaiting approval.');
    $lines[] = '';
  }

  // permalink() already points at the comment's fragment on its host page.
  $lines[] = t('Read it here: @url', [
    '@url' => $comment->permalink()->setAbsolute()->toString(),
  ]);

  $message['body'] = $lines;
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function peanut_gallery_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  if ($node->bundle() !== 'recording' || !in_array($variables['view_mode'], ['full', 'teaser'], TRUE)) {
    return;
  }
  if (!$node->hasField('field_audio_file') || $node->get('field_audio_file')->isEmpty()) {
    return;
  }
  /** @var \Drupal\file\FileInterface|null $file */
  $file = $node->get('field_audio_file')->entity;
  if (!$file) {
    return;
  }

  $variables['pg_waveform'] = [
    'player_id' => 'pg-waveform-' . $node->id(),
    'audio_url' => $file->createFileUrl(FALSE),
    'anonymous_comments_allowed' => $node->hasField('field_allow_anonymous_comments')
    && (bool) $node->get('field_allow_anonymous_comments')->value,
  ];

  if ($variables['view_mode'] === 'full') {
    $variables['pg_waveform']['file_name'] = $file->getFilename();
    $variables['pg_waveform']['file_size'] = (string) ByteSizeMarkup::create($file->getSize());
    $extension = strtoupper(pathinfo((string) $file->getFilename(), PATHINFO_EXTENSION));
    $variables['pg_waveform']['file_extension'] = $extension ?: NULL;
    $variables['pg_waveform']['uploaded'] = \Drupal::service('date.formatter')
      ->format($file->getCreatedTime(), 'custom', 'F j, Y');

    // If peaks have already been generated (see PeaksController/
    // PeaksGenerator), their cached duration doubles as a free, accurate
    // "how long is this recording" display that works even before the
    // player's own JS has loaded/decoded anything.
    $peaks = \Drupal::keyValue('peanut_gallery.peaks')->get('file:' . $file->id());
    if (is_array($peaks) && isset($peaks['duration'])) {
      $variables['pg_waveform']['duration_formatted'] = _peanut_gallery_format_timestamp((float) $peaks['duration']);
    }
  }

  $variables['#attached']['library'][] = 'peanut_gallery/waveform_player';
  $variables['#attached']['library'][] = 'peanut_gallery/comment_timestamp';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for comment templates.
 *
 * Unlike node, core's comment entity type does not add a
 * comment__{comment_type} suggestion on its own (comment's hook_theme()
 * declares no 'bundle' key), so comment--recording-comment.html.twig would
 * otherwise never be picked up.
 */
function peanut_gallery_theme_suggestions_comment_alter(array &$suggestions, array $variables): void {
  /** @var \Drupal\comment\CommentInterface $comment */
  $comment = $variables['elements']['#comment'];
  $suggestions[] = 'comment__' . $comment->bundle();
}

/**
 * Implements hook_preprocess_HOOK() for field--comment.html.twig.
 *
 * Reverses the comment list to newest-first. Deliberately implemented as
 * a *suggestion*-level preprocess (field__comment, i.e. the
 * field--comment.html.twig suggestion) rather than the base
 * hook_preprocess_field(): Drupal always runs every base-hook
 * implementation before any suggestion-level one, so this is guaranteed
 * to fire after comment module's own hook_preprocess_field() has already
 * populated $variables['comments'] — no dependency on module
 * registration/weight order between 'comment' and 'peanut_gallery'.
 *
 * Known limitation: only reorders comments *within* the page Drupal's
 * query already fetched. With more than one page of comments
 * (per_page: 50 on this field), later pages would still show older
 * comments in oldest-first chunks — acceptable for this module's
 * realistic comment volumes; a query-level fix would need overriding
 * CommentStorage::loadThread() or the formatter itself.
 */
function peanut_gallery_preprocess_field__comment(array &$variables): void {
  if (($variables['field_name'] ?? NULL) !== 'field_comment' || empty($variables['comments'])) {
    return;
  }

  $comments = $variables['comments'];
  $pager = $comments['pager'] ?? NULL;
  unset($comments['pager']);
  $comments = array_reverse($comments, TRUE);
  if ($pager !== NULL) {
    $comments['pager'] = $pager;
  }
  $variables['comments'] = $comments;
}

/**
 * Implements hook_preprocess_HOOK() for comment.html.twig.
 */
function peanut_gallery_preprocess_comment(array &$variables): void {
  /** @var \Drupal\comment\CommentInterface $comment */
  $comment = $variables['comment'];
  if ($comment->bundle() !== 'recording_comment' || !$comment->hasField('field_timestamp') || $comment->get('field_timestamp')->isEmpty()) {
    return;
  }
  $seconds = (float) $comment->get('field_timestamp')->value;
  $variables['pg_timestamp'] = $seconds;
  $variables['pg_timestamp_formatted'] = _peanut_gallery_format_timestamp($seconds);
}

/**
 * Formats a number of seconds as a m:ss.t string.
 *
 * Tenths are shown because a comment is pinned to a moment in audio, where
 * a whole second is a long time — "the drop" and a second after it are
 * different places in a mix. The field stores milliseconds (decimal 10,3);
 * tenths is simply the precision worth reading on screen.
 *
 * Rounding happens before the minutes are split out, so a value like 59.97
 * renders as 1:00.0 rather than 0:60.0.
 */
function _peanut_gallery_format_timestamp(float $seconds): string {
  $tenths = round(max(0.0, $seconds), 1);
  $minutes = (int) floor($tenths / 60);
  $remaining = $tenths - ($minutes * 60);
  return sprintf('%d:%04.1f', $minutes, $remaining);
}

/**
 * Implements hook_form_alter().
 */
function peanut_gallery_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'node_recording_form') {
    _peanut_gallery_alter_recording_node_form($form, $form_state);
  }
  elseif (str_starts_with($form_id, 'comment_recording_comment_form')) {
    _peanut_gallery_alter_recording_comment_form($form, $form_state);
  }
}

/**
 * Seeds the anonymous-comments default for newly created recordings.
 */
function _peanut_gallery_alter_recording_node_form(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || !$node->isNew() || !isset($form['field_allow_anonymous_comments']['widget']['value'])) {
    return;
  }
  $default = \Drupal::config('peanut_gallery.settings')->get('default_allow_anonymous_comments');
  $form['field_allow_anonymous_comments']['widget']['value']['#default_value'] = (bool) $default;
}

/**
 * Enforces the anonymous-comments override, styles the timestamp widget.
 *
 * The enforcement here matters, not just the styling: when a Recording's
 * comment field is configured to display inline (form_location: true, as
 * this module ships it — needed so the form sits next to the waveform
 * player), core's CommentDefaultFormatter::viewElements() decides whether
 * to build this form based purely on the flat 'post comments' permission.
 * It never consults hook_comment_create_access() at all, so that hook
 * alone would leave anonymous users able to submit comments on any
 * recording with the per-recording flag off, as long as the anonymous
 * role has the generic 'post comments' permission. This must be enforced
 * here instead.
 */
function _peanut_gallery_alter_recording_comment_form(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof EntityFormInterface) {
    $comment = $form_object->getEntity();
    $host = $comment instanceof CommentInterface ? $comment->getCommentedEntity() : NULL;
    if ($host instanceof NodeInterface) {
      $can_create = \Drupal::entityTypeManager()->getAccessControlHandler('comment')->createAccess(
        'recording_comment',
        \Drupal::currentUser(),
        ['commented_entity' => $host, 'field_name' => 'field_comment'],
      );
      if (!$can_create) {
        // #access alone does not stop Form API from processing
        // validate/submit handlers for a request supplying a
        // guessed/replayed form_build_id, so also block submission
        // explicitly below rather than relying on this to hide the form.
        $form['#access'] = FALSE;
        $form['#validate'][] = '_peanut_gallery_deny_comment_submission';
        return;
      }
    }
  }

  // Strip the text-format chrome from the comment body. The format select
  // and its "No HTML tags allowed…" guidelines are noise on a form whose
  // whole job is one sentence about a moment in a recording.
  //
  // The callback goes on widget[0], which is the text_format element
  // itself — widget[0]['value'] is only its textarea child, and
  // filter_process_format() builds the 'format' wrapper as a sibling of
  // that, not inside it.
  if (($form['comment_body']['widget'][0]['#type'] ?? NULL) === 'text_format') {
    $form['comment_body']['widget'][0]['#after_build'][] = '_peanut_gallery_hide_text_format_chrome';
  }

  if (!isset($form['field_timestamp']['widget'][0]['value'])) {
    return;
  }
  $form['field_timestamp']['#attributes']['class'][] = 'pg-timestamp-field-wrapper';
  $form['field_timestamp']['#weight'] = -10;

  $widget = &$form['field_timestamp']['widget'][0]['value'];
  $widget['#description'] = t('Click the waveform above to set this automatically, or enter the number of seconds into the recording manually.');

  // Progressive-enhancement fallback for JS-disabled clients following a
  // "seek to this point and comment" link built as ?t=123.4.
  $request = \Drupal::request();
  if (!isset($widget['#default_value']) && $request->query->has('t')) {
    $seconds = (float) $request->query->get('t');
    if ($seconds >= 0) {
      $widget['#default_value'] = $seconds;
    }
  }
}

/**
 * Form #after_build callback: hides the text format selector and its tips.
 *
 * The 'format' child only exists after filter_process_format() has run, so
 * this cannot be done in hook_form_alter() — hence #after_build.
 *
 * Hiding the wrapper rather than just the guidelines removes the select,
 * the "No HTML tags allowed…" list and the "About text formats" link
 * together. Marking it inaccessible (rather than unsetting it) is the
 * deliberate choice: Form API supplies the default value for inaccessible
 * elements and ignores user input for them, so the body still saves with
 * the field's configured format and a crafted POST cannot swap in a more
 * permissive one.
 */
function _peanut_gallery_hide_text_format_chrome(array $element, FormStateInterface $form_state): array {
  if (isset($element['format'])) {
    $element['format']['#access'] = FALSE;
  }
  return $element;
}

/**
 * Form #validate callback: unconditionally blocks submission.
 *
 * Paired with #access = FALSE in _peanut_gallery_alter_recording_comment_form()
 * — see that function's docblock for why both are needed.
 */
function _peanut_gallery_deny_comment_submission(array &$form, FormStateInterface $form_state): void {
  $form_state->setErrorByName('', t('You are not allowed to comment on this recording.'));
}
