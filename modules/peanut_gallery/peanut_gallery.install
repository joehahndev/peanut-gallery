<?php

/**
 * @file
 * Install, update and uninstall hooks for the Peanut Gallery module.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Bytes;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\Core\StringTranslation\ByteSizeMarkup;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\NodeAccessRebuild;

/**
 * Implements hook_schema().
 *
 * Push subscriptions are deliberately a plain table rather than a content
 * entity: they are per-browser device tokens, not content. They have no
 * revisions, no fields to configure, no translations, and nothing should
 * ever render one. A table also makes the "delete every subscription whose
 * endpoint the push service just rejected" cleanup a single query.
 */
function peanut_gallery_schema(): array {
  $schema['peanut_gallery_push_subscription'] = [
    'description' => 'Web Push subscriptions, one row per browser/device.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'The user this browser was subscribed by.',
      ],
      'endpoint' => [
        'type' => 'text',
        'not null' => TRUE,
        'description' => 'Push service URL to deliver to.',
      ],
      'endpoint_hash' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Hash of endpoint; endpoints are too long to index directly.',
      ],
      'p256dh' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Client public key for payload encryption.',
      ],
      'auth' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Client auth secret for payload encryption.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When this subscription was registered.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      // One row per browser: re-subscribing the same browser updates rather
      // than piling up duplicates that would each fire a notification.
      'endpoint_hash' => ['endpoint_hash'],
    ],
    'indexes' => [
      'uid' => ['uid'],
    ],
  ];

  $schema['peanut_gallery_invite'] = [
    'description' => 'Single-use invitation codes for creating an account.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'code_hash' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'SHA-256 of the invite code. The code itself is never stored, so a database leak cannot be replayed into free accounts.',
      ],
      'nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Recording the accepting user is granted access to.',
      ],
      'created_by' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Who issued the invite.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When it was issued.',
      ],
      'expires' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'After this, the code is refused.',
      ],
      'accepted_uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'User created by this invite; non-zero means spent.',
      ],
      'accepted' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When it was redeemed.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'code_hash' => ['code_hash'],
    ],
    'indexes' => [
      'nid' => ['nid'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Installing this module changes the effective node access model (see
 * Drupal\peanut_gallery\Access\RecordingGrantsBuilder). Critically, this
 * rebuilds grants IMMEDIATELY rather than just flagging "needs rebuild"
 * for an admin to notice later: before peanut_gallery existed, node module
 * (or no node-access module at all) will have written a permissive
 * "default grant" row (nid 0, realm 'all', gid 0) that makes every
 * published node visible regardless of our own grants — the query in
 * NodeGrantDatabaseStorage::access() always ORs that row in for published
 * nodes. That stale row isn't removed by merely setting the "needs
 * rebuild" flag; only an actual rebuild deletes and recomputes it. Leaving
 * this until an admin happens to click "Rebuild permissions" would mean
 * every private recording is effectively public from the moment this
 * module is enabled until they do — unacceptable for a module whose whole
 * purpose is enforcing that privacy.
 */
function peanut_gallery_install(): void {
  _peanut_gallery_rebuild_node_access(TRUE);
}

/**
 * Implements hook_uninstall().
 *
 * The access model reverts on uninstall too. This case is lower-urgency
 * (uninstalling a privacy-restricting module making content MORE visible
 * again is a "fail open" admins are likely to expect/notice), so flagging
 * for the normal admin-triggered rebuild is sufficient here.
 */
function peanut_gallery_uninstall(): void {
  _peanut_gallery_rebuild_node_access(FALSE);
}

/**
 * Rebuilds node access grants, or flags them for rebuild, across core versions.
 *
 * The old node_access_needs_rebuilding()/node_access_rebuild() functions
 * were deprecated in drupal:11.4.0 and are already fully removed as of
 * this writing — replaced by the NodeAccessRebuild service. This module's
 * core_version_requirement spans both, so support both rather than
 * assuming either is present.
 */
function _peanut_gallery_rebuild_node_access(bool $immediately): void {
  if (class_exists(NodeAccessRebuild::class) && \Drupal::hasService(NodeAccessRebuild::class)) {
    $rebuilder = \Drupal::service(NodeAccessRebuild::class);
    if ($immediately) {
      $rebuilder->rebuild();
    }
    else {
      $rebuilder->setNeedsRebuild(TRUE);
    }
    return;
  }

  if ($immediately && function_exists('node_access_rebuild')) {
    // Only reached on core versions where NodeAccessRebuild doesn't exist
    // yet, i.e. where this isn't actually deprecated.
    // @phpstan-ignore function.deprecated
    node_access_rebuild();
  }
  elseif (function_exists('node_access_needs_rebuilding')) {
    node_access_needs_rebuilding(TRUE);
  }
}

/**
 * Rewrites node access grants to be view-only (security fix).
 *
 * Until now every grant record this module wrote carried grant_update and
 * grant_delete set to 1, including the 'peanut_gallery_view' realm that is
 * granted to gid 0 — everyone, anonymous included. Because node grants are
 * an allow layer rather than a filter over permissions, that gave every
 * visitor edit and delete rights on every public recording.
 *
 * RecordingGrantsBuilder now writes view-only records, but the rows already
 * in {node_access} were written by the old code and are still live, so an
 * existing site stays vulnerable until they are rewritten. Hence a real,
 * synchronous rebuild here rather than merely flagging one: leaving the bad
 * rows in place pending an admin noticing the "rebuild permissions" prompt
 * is not an acceptable window for this particular bug.
 */
function peanut_gallery_update_10001(): void {
  _peanut_gallery_rebuild_node_access(TRUE);
}

/**
 * Turns off the comment preview button on existing sites.
 *
 * Shipped config/install only seeds a fresh install, so a site that already
 * has the field keeps whatever it was installed with. A recording comment
 * is one sentence about a moment in a mix — there is nothing worth
 * previewing, and the extra round-trip is pure friction.
 */
function peanut_gallery_update_10002(): void {
  $config = \Drupal::configFactory()->getEditable('field.field.node.recording.field_comment');
  if ($config->isNew()) {
    return;
  }
  // 0 = DRUPAL_DISABLED.
  $config->set('settings.preview', 0)->save();
}

/**
 * Makes the comment timestamp optional (bug fix).
 *
 * The field shipped as required while its widget is visually hidden, on
 * the assumption that people would always set it by clicking the waveform.
 * When they did not, the browser blocked submission over an invisible
 * control: the comment form simply did nothing, with no message and
 * nothing to click. It also contradicted the Clear button the comment JS
 * renders. A comment with no timestamp is a perfectly reasonable thing to
 * leave on a recording, and everything downstream already handles one —
 * peanut_gallery_preprocess_comment() skips empty values, so no badge and
 * no waveform marker are drawn.
 */
function peanut_gallery_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('field.field.comment.recording_comment.field_timestamp');
  if ($config->isNew()) {
    return;
  }
  $config->set('required', FALSE)->save();
}

/**
 * Creates the push subscription table on existing sites.
 */
function peanut_gallery_update_10004(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('peanut_gallery_push_subscription')) {
    $tables = peanut_gallery_schema();
    $schema->createTable('peanut_gallery_push_subscription', $tables['peanut_gallery_push_subscription']);
  }
}

/**
 * Creates the invite table on existing sites.
 */
function peanut_gallery_update_10005(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('peanut_gallery_invite')) {
    $tables = peanut_gallery_schema();
    $schema->createTable('peanut_gallery_invite', $tables['peanut_gallery_invite']);
  }
}

/**
 * Adds the resolved field to recording comments on existing sites.
 */
function peanut_gallery_update_10006(): void {
  if (!FieldStorageConfig::loadByName('comment', 'field_resolved')) {
    FieldStorageConfig::create([
      'field_name' => 'field_resolved',
      'entity_type' => 'comment',
      'type' => 'boolean',
    ])->save();
  }
  if (!FieldConfig::loadByName('comment', 'recording_comment', 'field_resolved')) {
    FieldConfig::create([
      'field_name' => 'field_resolved',
      'entity_type' => 'comment',
      'bundle' => 'recording_comment',
      'label' => 'Resolved',
      'default_value' => [['value' => 0]],
      'settings' => [
        'on_label' => 'Resolved',
        'off_label' => 'Open',
      ],
    ])->save();
  }
}

/**
 * Adds the download toggle to recordings on existing sites.
 *
 * Defaults to off for everything that already exists. A site that has been
 * sharing private recordings did not consent to offering the files for
 * download by installing an update, so the new capability starts silent
 * and is opted into per recording.
 */
function peanut_gallery_update_10007(): void {
  if (!FieldStorageConfig::loadByName('node', 'field_allow_download')) {
    FieldStorageConfig::create([
      'field_name' => 'field_allow_download',
      'entity_type' => 'node',
      'type' => 'boolean',
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'recording', 'field_allow_download')) {
    FieldConfig::create([
      'field_name' => 'field_allow_download',
      'entity_type' => 'node',
      'bundle' => 'recording',
      'label' => 'Offer a download link',
      'description' => 'When enabled, anyone who can listen to this recording also gets a link to download the original audio file. It does not change who may reach the file — a listener can already save the audio their browser is streaming — it only offers it explicitly.',
      'default_value' => [['value' => 0]],
      'settings' => [
        'on_label' => 'Offered',
        'off_label' => 'Not offered',
      ],
    ])->save();
  }

  // Put the widget on the edit form and keep the raw field off the page —
  // the module renders the link itself, next to the player.
  $form_display = EntityFormDisplay::load('node.recording.default');
  if ($form_display && !$form_display->getComponent('field_allow_download')) {
    $form_display->setComponent('field_allow_download', [
      'type' => 'boolean_checkbox',
      'weight' => 14.7,
      'region' => 'content',
      'settings' => ['display_label' => TRUE],
    ])->save();
  }
  $view_display = EntityViewDisplay::load('node.recording.default');
  if ($view_display) {
    $view_display->removeComponent('field_allow_download')->save();
  }
}

/**
 * Implements hook_requirements().
 *
 * Raising the Recording audio field's own "maximum upload size" setting is
 * not sufficient by itself — PHP's upload_max_filesize/post_max_size (and,
 * operationally, the webserver's own request-size/timeout limits) must be
 * raised to match, or long recordings will still be rejected.
 */
#[LegacyRequirementsHook]
function peanut_gallery_requirements(string $phase): array {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  $field = FieldConfig::loadByName('node', 'recording', 'field_audio_file');
  $field_max_setting = $field?->getSetting('max_filesize');
  if (!$field || empty($field_max_setting)) {
    return $requirements;
  }

  $field_max_bytes = Bytes::toNumber($field_max_setting);
  $php_max_bytes = min(
    Bytes::toNumber((string) ini_get('upload_max_filesize')),
    Bytes::toNumber((string) ini_get('post_max_size')),
  );

  if ($php_max_bytes < $field_max_bytes) {
    $requirements['peanut_gallery_upload_limits'] = [
      'title' => t('Peanut Gallery upload limits'),
      'value' => t('PHP currently allows uploads up to @php, but the Recording audio file field allows up to @field.', [
        '@php' => ByteSizeMarkup::create($php_max_bytes),
        '@field' => ByteSizeMarkup::create($field_max_bytes),
      ]),
      'description' => t('Raise upload_max_filesize and post_max_size (and check your webserver\'s own request-size and timeout limits, e.g. nginx client_max_body_size/fastcgi_read_timeout) to match, or lower the field\'s "Maximum upload size".'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }

  /** @var \Drupal\peanut_gallery\Peaks\PeaksGenerator $peaksGenerator */
  $peaksGenerator = \Drupal::service('peanut_gallery.peaks_generator');
  $requirements['peanut_gallery_peaks'] = $peaksGenerator->isAvailable()
    ? [
      'title' => t('Peanut Gallery waveform peaks'),
      'value' => t('ffmpeg found — waveforms will be precomputed and cached on first play.'),
      'severity' => REQUIREMENT_OK,
    ]
    : [
      'title' => t('Peanut Gallery waveform peaks'),
      'value' => t('ffmpeg not found — waveforms will decode client-side, which is slower for long recordings.'),
      'description' => t('Optional: install ffmpeg (commonly available in dev environments) and run <code>drush peanut-gallery:peaks-backfill</code>. Peaks are stored in the database, so a database sync to a host without ffmpeg (e.g. shared hosting) still serves cached peaks fine.'),
      'severity' => REQUIREMENT_INFO,
    ];

  return $requirements;
}
