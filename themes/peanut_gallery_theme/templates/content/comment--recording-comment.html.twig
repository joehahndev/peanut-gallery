{#
/**
 * @file
 * Theme override for a timestamped Recording comment.
 *
 * In addition to the standard comment.html.twig variables, this expects
 * `pg_timestamp` and `pg_timestamp_formatted` (set by
 * peanut_gallery_preprocess_comment()). The timestamp badge is rendered as
 * plain text, not a link — it only becomes an interactive seek control
 * once peanut_gallery's JS attaches (see waveform-player.js, which reads
 * data-comment-id/data-timestamp off this article element), so a no-JS
 * visitor never sees a dead/misleading control.
 *
 * Uses `author`/`created` (set individually by core's comment preprocess,
 * alongside the combined `submitted` string) rather than `submitted`
 * itself, for header layout control.
 */
#}
{%
  set classes = [
    'comment',
    'js-comment',
    'pg-comment',
    status != 'published' ? status,
    comment.owner.anonymous ? 'by-anonymous',
    author_id and author_id == commented_entity.getOwnerId() ? 'by-' ~ commented_entity.getEntityTypeId() ~ '-author',
  ]
%}
<article{{ attributes.addClass(classes) }}
  {%- if pg_timestamp is not null %} data-comment-id="{{ comment.id }}" data-timestamp="{{ pg_timestamp }}"{% endif -%}
>
  <header class="pg-comment__header">
    {% if pg_timestamp_formatted %}
      {# A button, not a span: jumping playback to this moment is an action,
         so it should be reachable and operable by keyboard without
         reinventing any of that on a div. #}
      <button type="button" class="pg-comment-timestamp" data-pg-seek
        title="{{ 'Play from @time'|t({'@time': pg_timestamp_formatted}) }}">
        {{- pg_timestamp_formatted -}}
      </button>
    {% endif %}
    <span class="pg-comment__author">{{ author }}</span>
    <span class="pg-comment__date">{{ created }}</span>
    {% if pg_moment_url %}
      {# A real link that works without JS (opens the page seeked to this
         moment); review-loop.js upgrades a click into copy-to-clipboard. #}
      <a class="pg-comment-link" href="{{ pg_moment_url }}"
        title="{{ 'Link to this moment'|t }}">{{ 'Link'|t }}</a>
    {% endif %}
    {% if pg_resolve_url %}
      {# Only rendered for the recording owner and the comment's author —
         peanut_gallery_preprocess_comment() decides. Server-side access on
         the route decides again; this is presentation, not protection. #}
      <button type="button" class="pg-comment-resolve" data-pg-resolve="{{ pg_resolve_url }}">
        {{- pg_resolved ? 'Reopen'|t : 'Resolve'|t -}}
      </button>
    {% endif %}
    {% if permalink %}
      <span class="pg-comment__permalink">{{ permalink }}</span>
    {% endif %}
  </header>

  <div{{ content_attributes.addClass('pg-comment__body') }}>
    {{ content }}
  </div>
</article>
