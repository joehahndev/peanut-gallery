{#
/**
 * @file
 * Compact teaser for a Recording node: title + a small waveform player,
 * no comment list. See node--recording.html.twig for the pg_waveform
 * variable contract.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    'node--view-mode-teaser',
    not node.isPublished() ? 'node--unpublished',
  ]
%}
<article{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  <h2{{ title_attributes }}>
    <a href="{{ url }}" rel="bookmark">{{ label }}</a>
  </h2>
  {{ title_suffix }}

  {% if pg_waveform %}
    <div
      id="{{ pg_waveform.player_id }}"
      class="pg-waveform pg-waveform--teaser"
      data-player-id="{{ pg_waveform.player_id }}"
      data-node-id="{{ node.id }}"
      data-audio-url="{{ pg_waveform.audio_url }}"
      data-loading-text="{{ 'Loading waveform…'|t }}"
    ></div>

    {# Same progressive-enhancement contract as the full view: hidden until
       waveform-player.js finds it. #}
    <div class="pg-waveform-meta pg-waveform-meta--teaser">
      <button
        type="button"
        class="pg-waveform-toggle"
        data-player-id="{{ pg_waveform.player_id }}"
        hidden
      >{{ 'Play'|t }}</button>
      <span class="pg-waveform-time" data-player-id="{{ pg_waveform.player_id }}"></span>
    </div>
  {% endif %}

</article>
