{#
/**
 * @file
 * Theme override for a Recording node: waveform player + comment field.
 *
 * In addition to the standard node.html.twig variables, this template
 * expects `pg_waveform` (set by peanut_gallery_preprocess_node()):
 * - pg_waveform.player_id: unique id for this page's player instance.
 * - pg_waveform.audio_url: URL to the recording's audio (routes through
 *   hook_file_download() for private recordings).
 * - pg_waveform.anonymous_comments_allowed: bool, informational only.
 * - pg_waveform.file_name / file_size / file_extension / uploaded: file
 *   metadata (full view mode only).
 * - pg_waveform.duration_formatted: m:ss, only present once this
 *   recording's waveform peaks have been generated at least once.
 *
 * The container below is intentionally empty markup — wavesurfer.js
 * renders its waveform into it at runtime. Without JavaScript it stays
 * empty and the <noscript> message explains why; the comment list and
 * form below still work normally either way.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
<article{{ attributes.addClass(classes) }}>

  {# On a full node page the page-title block already renders the title, so
     printing it here too would produce two identical headings. Same
     condition the theme's own node.html.twig uses. title_prefix/suffix stay
     unconditional — modules hang contextual links off them. #}
  {{ title_prefix }}
  {% if label and view_mode != 'full' %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <div class="pg-recording__meta">
      {% trans %}Uploaded by {{ author_name }} on {{ date }}{% endtrans %}
    </div>
  {% endif %}

  {% if pg_waveform %}
    <div
      id="{{ pg_waveform.player_id }}"
      class="pg-waveform"
      data-player-id="{{ pg_waveform.player_id }}"
      data-node-id="{{ node.id }}"
      data-audio-url="{{ pg_waveform.audio_url }}"
      data-loading-text="{{ 'Loading waveform…'|t }}"
    ></div>
    <noscript>
      <p class="pg-waveform-noscript">{{ 'Enable JavaScript to see and use the waveform player. You can still read and post comments below.'|t }}</p>
    </noscript>

    <div class="pg-waveform-meta">
      <span class="pg-waveform-time" data-player-id="{{ pg_waveform.player_id }}">
        {%- if pg_waveform.duration_formatted -%}0:00 / {{ pg_waveform.duration_formatted }}{%- endif -%}
      </span>
      {% if pg_waveform.file_name %}
        <span class="pg-waveform-file-info">
          <span>{{ pg_waveform.file_name }}</span>
          <span>{{ pg_waveform.file_size }}</span>
          {% if pg_waveform.file_extension %}<span>{{ pg_waveform.file_extension }}</span>{% endif %}
          <span>{{ 'Uploaded @date'|t({'@date': pg_waveform.uploaded}) }}</span>
        </span>
      {% endif %}
    </div>
  {% endif %}

  <div{{ content_attributes.addClass('node__content') }}>
    {{ content }}
  </div>

</article>
